# 复制为 .env.local（本地）或 .env.server（服务器），填入真实值。
# 两者都被 .gitignore 排除，绝不要提交。

# ---------- 数据库 ----------
# 本地：postgresql://postgres:postgres@localhost:5432/reborn
# 服务器：由 deploy.sh 用 PG_USER/PG_PASSWORD/PG_DB 拼出，指向 docker 网络内的 reborn-db
DATABASE_URL=postgresql://user:password@localhost:5432/reborn

# ---------- 对象存储（腾讯云 COS）----------
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-shanghai
COS_PREFIX=reborn
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---------- 应用 ----------
# 复习卷二维码里写死的地址，必须是孩子手机能访问到的完整前缀
BASE_URL=http://127.0.0.1:3000
# 部署在 Caddy 子路径下时设为 /reborn，本地留空
NEXT_PUBLIC_BASE_PATH=

# ---------- 鉴权（T9）----------
# 全站共享口令。没有账号体系，所有人用同一个。
APP_PASSWORD=
# 会话 cookie 的签名密钥，至少 16 字符。部署时留空会自动生成并写回 .env.server。
# 换掉它 = 所有人被登出。
SESSION_SECRET=

# ---------- 自助领取（发家长群的那条链接）----------
# 允许自助开户的家庭总数上限。0 = 关闭自助领取（默认），只能我手动发链接。
# 名额满了就不再开户，多出来的用 deploy/invite.sh 看到后删掉即可。
CLAIM_LIMIT=0
# 领取链接里的暗号：/claim?c=<这里>。挡扫路径的爬虫，不挡转发。
# 想立刻作废群里那条链接，改掉它重新部署即可。
CLAIM_CODE=

# ---------- 自动切题 ----------
# none = 关闭，纯手动圈题；vlm = 调用视觉模型自动切题
# 注意：漏配这一行时接口会正常返回 0 个框，表现得像模型不可用。deploy.sh 已加校验。
DETECT_MODE=none
VLM_BASE_URL=https://api.moonshot.cn/v1
VLM_API_KEY=
VLM_MODEL=kimi-k2.7-code-highspeed

# ---------- 仅 deploy.sh 使用（.env.server）----------
PG_USER=reborn
PG_PASSWORD=
PG_DB=reborn
